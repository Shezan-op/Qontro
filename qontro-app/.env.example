# ==============================================================================
# QONTRO SAAS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-jwt-key"

# Server-only service role key (Required for administrative backend tasks / triggers)
# NEVER prefix with NEXT_PUBLIC_ — this must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 2. AI Service Configuration (DeepSeek / Ollama Cloud)
# ------------------------------------------------------------------------------
OLLAMA_HOST="https://api.ollama.com"
OLLAMA_MODEL="deepseek-v4-flash:cloud"
OLLAMA_API_KEY="your-ollama-cloud-api-key"

# ------------------------------------------------------------------------------
# 3. Application Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
